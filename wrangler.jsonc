{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucy",
  "compatibility_date": "2026-09-10",

  // Run `npm run cf:init` after npm install so vinext can augment/generate
  // the exact Worker entry/build settings for the current vinext release.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lucy",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lucy-files"
    }
  ],

  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lucy-dev",
          "database_id": "REPLACE_WITH_DEV_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "lucy-files-dev"
        }
      ]
    }
  }
}
