{
  "name": "lucy",
  "version": "0.11.2",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3001",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:check": "npx vinext check",
    "cf:init": "npx vinext init",
    "cf:typegen": "npx wrangler types",
    "test:e2e": "node --test scripts/auth-e2e.mjs",
    "db:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "npx wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:prod": "./scripts/migrate-production.sh",
    "infra:create": "./scripts/create-infra.sh",
    "infra:list": "./scripts/list-infra.sh",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:dev": "CLOUDFLARE_ENV=dev vinext build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "better-auth": "^1.7.4",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "latest",
    "vinext": "latest",
    "vite": "^8.3.0",
    "wrangler": "latest"
  },
  "type": "module"
}
